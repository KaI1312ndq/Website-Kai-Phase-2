# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_READ_TOKEN=your_read_token_here

# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Email (Resend for contact form)
RESEND_API_KEY=your_resend_key_here
CONTACT_EMAIL=qforwork13@gmail.com

# ============================================
# AI Video Studio (Phase 1+)
# ============================================
# fal.ai - Kling 3.0 + Flux Schnell
FAL_KEY=your_fal_key_here

# Anthropic - Claude Haiku 4.5 for script generation
ANTHROPIC_API_KEY=sk-ant-...

# FPT.AI - TTS v5 Vietnamese voice
FPT_TTS_API_KEY=your_fpt_key_here

# Casso - VietQR webhook auto-confirm
CASSO_API_KEY=your_casso_key_here
CASSO_WEBHOOK_SECRET=your_casso_webhook_secret

# Upstash Redis - BullMQ queue
UPSTASH_REDIS_URL=rediss://default:...@us1-...upstash.io:6379
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token

# Cloudflare R2 - video + asset storage
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_BUCKET_VIDEOS=kai-video-prod
R2_PUBLIC_URL=https://videos.nguyenducquang.website

# Worker callback secret (worker -> web API to update job status)
VIDEO_WORKER_SECRET=long_random_string_min_32_chars

# Momo (optional - phase 2)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
